# netboot-xyz runtime settings. Copy to .env and adjust. No secrets live here.
# Read by docker compose only (no TypeScript code reads env, so @sonni4154/marin-config does not apply yet).

# Image tag, pinned. Check ghcr.io/netbootxyz/netbootxyz for newer tags before bumping.
NETBOOT_IMAGE_TAG=0.7.6-nbxyz26

# blackknight's address on the PXE VLAN (LAN, VLAN 10). TFTP and the asset mirror listen here only.
NETBOOT_LAN_IP=10.10.10.98
NETBOOT_TFTP_PORT=69
NETBOOT_ASSETS_PORT=8080

# The admin web UI has no login. Keep it on 127.0.0.1, never the LAN IP or 0.0.0.0.
# Reach it with `tailscale serve` (see README) or an SSH tunnel. Not the Tailscale IP: if Tailscale is
# down at boot, Docker can't bind it and the whole container (TFTP included) fails to start.
NETBOOT_ADMIN_IP=127.0.0.1
NETBOOT_ADMIN_PORT=3001

# Menu version served on first boot; empty means latest upstream release.
NETBOOT_MENU_VERSION=
